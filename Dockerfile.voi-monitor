FROM python:3.13-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup -S collector \
    && adduser -S collector -G collector

COPY scripts/voi-requirements.txt /app/scripts/voi-requirements.txt
RUN pip install --no-cache-dir -r scripts/voi-requirements.txt
COPY --chown=collector:collector scripts/collect_voi_vehicles.py scripts/voi_database.py scripts/voi_api.py scripts/voi_schema.sql /app/scripts/

USER collector

CMD ["python3", "-m", "scripts.voi_database"]
